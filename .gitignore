# dependencies / build
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts
.env*

# generated content — build artifacts, never committed.
# Modules (.mdx) and the index are produced upstream (tex -> mdx converter /
# CI); figures land in public/uploads/. The repo holds sources, not outputs.
content/modules/
content/index.json
public/uploads/
public/downloads/

# LaTeX build artifacts (compiled PDFs are downstream artifacts too —
# figure PDFs under tex/*/figures/ are the one committed exception)
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.pdf
!tex/*/fig/*.pdf

# misc
.DS_Store
