*.synctex(busy)
*.dvi
*.xdv
*.lof
*.lot
*.idx
*.ilg
*.ind
*.thm
*.spl
*.nav
*.snm
*.vrb
comment.cut
_minted*/
*.pyg
*.pdf
!tex/*/fig/*.pdf

