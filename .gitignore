# dependencies / build
# No trailing slash: new-worktree.sh wires up node_modules as a SYMLINK, and
# `node_modules/` matches directories only — the symlinks showed as untracked
# and one `git add -A` committed one (an absolute path, dead on every other
# machine). Matching by name covers the real directory and the symlink both.
node_modules
.next/
out/
*.tsbuildinfo
next-env.d.ts
.env*
_src/
scratch/
_src_repo/
# generated content — build artifacts, never committed.
# Modules (.mdx) and the index are produced upstream (tex -> mdx converter /
# CI); figures land in public/uploads/. The repo holds sources, not outputs.
content/modules/
content/index.json
# derived from schedule.yaml (committed) + what the build produced
content/status.json
public/uploads/
public/downloads/

# Per-folder iliad.sty copies are for working OUTSIDE the repo (main.tex
# looks locally first, then one level up). In the repo everyone uses the
# shared tex/iliad.sty, so local copies must never be committed.
tex/*/iliad.sty

# LaTeX build artifacts (compiled PDFs are downstream artifacts too —
# figure PDFs under tex/*/fig/ are the one committed exception)
tex/*/main-nosol.*
tex/*/main.autolabel.tex
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.bcf
*.run.xml
*.brf
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.dvi
*.xdv
*.lof
*.lot
*.idx
*.ilg
*.ind
*.thm
*.spl
*.nav
*.snm
*.vrb
comment.cut
_minted*/
*.pyg
*.pdf
!tex/*/fig/*.pdf

# misc
.DS_Store

# cloned source repos for MATERIAL.md hunt (see MATERIAL.md handoff)
repos/

# git worktrees kept inside the repo. Both patterns matter: the root-anchored
# one is where new-worktree.sh puts them, and `.claude/worktrees/` is where the
# agent harness puts its own — each a full checkout, and NOT covered by the
# anchored pattern, so without this line `git add .claude/` (to commit the
# skills) stages an embedded git repo as a broken gitlink.
/worktrees/
.claude/worktrees/
