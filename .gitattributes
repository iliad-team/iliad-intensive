tex/**/fig/*.png filter=lfs diff=lfs merge=lfs -text
tex/**/fig/*.jpg filter=lfs diff=lfs merge=lfs -text

# C.2's deck keeps its figures in per-lecture subdirectories under fig/
# (fig/03_transformer_features/figures/elhage2022/…), and a single * does not
# cross a /, so the lines above miss them. Match at any depth — without this,
# 25 MB of PNGs go into git as raw blobs instead of LFS pointers.
tex/**/fig/**/*.png filter=lfs diff=lfs merge=lfs -text
tex/**/fig/**/*.jpg filter=lfs diff=lfs merge=lfs -text
