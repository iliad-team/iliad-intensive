#!/bin/sh
# Run the CI ladder before every push, faithfully: build the worksheets git
# actually TRACKS (what CI will see — in-development untracked folders are
# skipped), then the static site, with the same commands the GitHub action
# runs. Environment parity is kept by installing the same TeX packages in
# ./setup.sh as in the workflow's apt list.
#
# Enable once per clone:   git config core.hooksPath .githooks   (./setup.sh does this)
# Bypass once:             git push --no-verify
# Reject the push with a consistent explanation: WHY it failed, WHERE the
# details are, and the escape hatch. The GitHub CI runs the same ladder, so
# a push that fails here would fail CI too.
reject() {
  echo ""
  echo "✗ push rejected: $1"
  echo "  The same CI ladder runs on GitHub, so this push would fail there too."
  echo "  Fix the errors reported above, then push again."
  echo ""
  echo "  If you know what you are doing, use 'git push --no-verify' to override."
  exit 1
}

# This repo pins core.hooksPath=.githooks, so git-lfs's own pre-push hook is
# never run. Capture the ref list git sends on stdin now (the CI ladder below
# doesn't need it) and hand it to `git lfs pre-push` once the ladder passes, so
# LFS objects (tex/**/fig/*.png) are uploaded with the push.
lfs_refs=$(cat)

slugs=$(git ls-files 'tex/*/main.tex' 'tex/*/main.mdx' | cut -d/ -f2 | sort -u | tr '\n' ' ')
echo "pre-push: CI ladder on tracked worksheets: $slugs"
if ! ./run.sh content $slugs; then
  reject "worksheet content build failed (see the file:line messages above)."
fi
if ! NEXT_PUBLIC_BASE_PATH=/iliad-intensive ./run.sh build; then
  reject "static site build failed (see the messages above)."
fi

# Upload Git LFS objects for the refs being pushed (see stdin capture above).
if command -v git-lfs >/dev/null 2>&1; then
  printf '%s\n' "$lfs_refs" | git lfs pre-push "$@" || reject "git lfs pre-push failed — LFS objects were not uploaded."
else
  reject "git-lfs is not installed but LFS-tracked files exist; run ./setup.sh (or install git-lfs) first."
fi

echo "✓ CI ladder green — pushing"
