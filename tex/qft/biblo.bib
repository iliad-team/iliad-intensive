@article{bergerComplexLangevinOther2021,
  title = {Complex {{Langevin}} and Other Approaches to the Sign Problem in Quantum Many-Body Physics},
  author = {Berger, C. E. and Rammelm{\"u}ller, L. and Loheac, A. C. and Ehmann, F. and Braun, J. and Drut, J. E.},
  year = 2021,
  month = jan,
  journal = {Physics Reports},
  series = {Complex {{Langevin}} and Other Approaches to the Sign Problem in Quantum Many-Body Physics},
  volume = {892},
  pages = {1--54},
  issn = {0370-1573},
  doi = {10.1016/j.physrep.2020.09.002},
  urldate = {2025-11-24},
  abstract = {We review the theory and applications of complex stochastic quantization to the quantum many-body problem. Along the way, we present a brief overview of a number of ideas that either ameliorate or in some cases altogether solve the sign problem, including the classic reweighting method, alternative Hubbard--Stratonovich transformations, dual variables (for bosons and fermions), Majorana fermions, density-of-states methods, imaginary asymmetry approaches, and Lefschetz thimbles. We discuss some aspects of the mathematical underpinnings of conventional stochastic quantization, provide a few pedagogical examples, and summarize open challenges and practical solutions for the complex case. Finally, we review the recent applications of complex Langevin to quantum field theory in relativistic and nonrelativistic quantum matter, with an emphasis on the nonrelativistic case.},
  keywords = {Complex Langevin,Condensed Matter - Quantum Gases,High Energy Physics - Lattice,Nuclear Theory,Sign problem,Stochastic quantization},
}
