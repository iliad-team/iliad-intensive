% iliad.sty — the Iliad Intensive worksheet contract
% Version 0.6 (2026-07-08)
%
% ONE shared copy lives at tex/iliad.sty. Worksheets load it local-first —
% a copy next to main.tex (the Overleaf setup) wins, else the shared parent
% copy:
%     \IfFileExists{iliad.sty}{\usepackage[boxes]{iliad}}{\usepackage[boxes]{../iliad}}
%
% This package defines the SMALL set of semantic environments that the
% tex -> MDX converter understands (the "contract zone"). Everything else —
% prose, math, \newcommand macros, extra packages, citations — is the
% "free zone": write whatever LaTeX you like and it converts faithfully.
%
% The contract is strict about its own names: worksheets must NOT define
% their own theorem/exercise/solution machinery — a clash is a loud compile
% error on purpose. Port legacy material to this format rather than working
% around it.
%
% PDF styling is PLAIN by default — style your PDF however you like (the
% website look is decided downstream and doesn't depend on it). Pass the
% [boxes] option for ready-made tcolorbox styling:
%     \usepackage[boxes]{iliad}
%
% Contract environments:
%
%   \begin{exercise}[Optional Title]  ... \end{exercise}
%       Standard amsthm note semantics: the optional argument IS the title.
%       Optional mark, written right after the \label:
%         \important        "(★) among the most important exercises" marker
%       Label the exercise if anything (a solution, a \cref) needs to point
%       at it; unlabeled exercises are allowed but draw a CI advisory.
%   \begin{learningoutcomes} \begin{itemize} \item ... \end{itemize} \end{...}
%       "What you'll learn" box; sits after Prerequisites, before the content
%       (docs/commands.md §"Front matter opens the sheet"). The body is
%       ordinary LaTeX: one \begin{itemize} of outcomes, or several groups each
%       introduced by \subsection*{Heading} and its own itemize (the group
%       headings render as bold subheadings on the web). Renders as the
%       matching box on the web.
%
% Title block: the website extracts its byline from \title{} and \author{}.
% \author supports affiliations:
%   \author{\authorname{Ada Lovelace}\\ \affiliation{Analytical Engines}
%           \and \authorname{...}\\ \affiliation{...}}
% Plain \author{A \and B} works too. The %--- iliad --- frontmatter block is
% only for simple one-line values (and takes precedence when both exist).
%   \begin{solution}[ex:some-label] ... \end{solution}
%       MUST name its exercise (compile error otherwise). Placement is free:
%       right after the exercise, or collected at the end — both fine.
%       Exercises do not require solutions. Collapsible on the web.
%       Hidden from the PDF by \solutionsfalse.
%   \begin{hint} ... \end{hint}
%       Unnumbered, never labeled, renders where it is written. PDF: a bold
%       "Hint:" lead-in. Web: a collapsible drop-down, like solutions.
%       (Short inline hints keep the \hint{...} command: "[Hint: ...]".)
%   \begin{proof} ... \end{proof}            (amsthm; collapsible on the web)
%   \begin{callout}[note|tip|warning] ... \end{callout}
%   \begin{remark} ... \end{remark}          (aside; note callout on the web)
%   \begin{teachingnote}[Title] ... \end{teachingnote}
%       teacher-facing aside; a collapsed drop-down on the web.
%   definition / theorem / lemma / proposition / corollary / fact / example
%       amsthm environments sharing one counter, numbered within section.
%
% The rules (all of them):
%   1. Pure-YAML frontmatter comment block at the very top of main.tex
%      (between "%--- iliad ---" and "%--- end ---").
%   2. Load this package (see the \IfFileExists line above).
%   3. \label anything you want to reference — exercises, theorems, callouts,
%      remarks all take labels. Any placement LaTeX binds correctly is valid
%      (top level of the environment); right after \begin{...} is clearest.
%   4. Exercise subparts are a plain enumerate; \label an \item to
%      cross-reference it ("Exercise 1.2(a)").
%   5. Solutions always carry [ex:label]; place them wherever you like.
%   6. Toggle solutions with \solutionsfalse after loading this package.
%
% Notes:
%   * hyperref and cleveref are loaded HERE (cleveref must come last).
%     Configure hyperref via \hypersetup{...}, do not re-load it.
%   * Don't \renewcommand/\renewenvironment anything this package defines
%     (CI rejects it — the converter relies on these definitions).

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{iliad}[2026/07/08 v0.6 Iliad Intensive worksheet contract]

\newif\ifiliad@boxes
\iliad@boxesfalse
\DeclareOption{boxes}{\iliad@boxestrue}
% Screen-first page geometry (compact page, tight margins) is the default so
% every worksheet fills the page uniformly. Pass [nogeometry] to opt out and
% supply your own paper/margins; or call \geometry{...} afterwards to tweak.
\newif\ifiliad@geometry
\iliad@geometrytrue
\DeclareOption{nogeometry}{\iliad@geometryfalse}
% Solutions are shown by default. Authors may write \solutionsfalse in the
% document, or load the package with [nosolutions], to hide every solution and
% solutionsonly block from their own PDF compile. (The site build produces its
% spoiler-free -nosol downloads by stripping instead; see build-content.mjs.)
\newif\ifsolutions
\solutionstrue
\DeclareOption{nosolutions}{\solutionsfalse}
\ProcessOptions\relax

\ifiliad@geometry
  % includefoot keeps the 1cm margins but reserves the footer inside the margin
  % box, so page numbers (and any \cfoot) print on the page instead of hanging
  % off the bottom edge.
  \RequirePackage[paperwidth=6.5in, paperheight=9.5in, margin=1cm, includefoot]{geometry}
\fi

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{amsthm}
\RequirePackage{etoolbox}
\RequirePackage{enumitem}
\RequirePackage{graphicx}
\RequirePackage{verbatim}      % comment machinery used to hide solutions
\ifiliad@boxes
  \RequirePackage{tcolorbox}
  \tcbuselibrary{breakable}
  % ------------------------------------------------------- web palette ---
  % The SAME colours the website gives each box (src/lib/mdx.tsx, Tailwind),
  % so the PDF and the web page read as one artifact. Each box is a light
  % "-50" background with its "-300"/"-500" border colour. If the site's
  % styling changes, change these to match — the site is the reference.
  \definecolor{iliadOrange50}{HTML}{FFF7ED}   % exercise      bg-orange-50
  \definecolor{iliadOrange300}{HTML}{FDBA74}  % exercise      border-orange-300
  \definecolor{iliadIndigo50}{HTML}{EEF2FF}   % definition    bg-indigo-50
  \definecolor{iliadIndigo300}{HTML}{A5B4FC}  % definition    border-indigo-300
  \definecolor{iliadViolet50}{HTML}{F5F3FF}   % theorem fam.  bg-violet-50
  \definecolor{iliadViolet500}{HTML}{8B5CF6}  % theorem fam.  border-violet-500
  \definecolor{iliadSky50}{HTML}{F0F9FF}      % note/remark   bg-sky-50
  \definecolor{iliadSky500}{HTML}{0EA5E9}     % note/remark   border-sky-500
  \definecolor{iliadEmerald50}{HTML}{ECFDF5}  % tip/example   bg-emerald-50
  \definecolor{iliadEmerald500}{HTML}{10B981} % tip/example   border-emerald-500
  \definecolor{iliadAmber50}{HTML}{FFFBEB}    % warning       bg-amber-50
  \definecolor{iliadAmber500}{HTML}{F59E0B}   % warning       border-amber-500
  \definecolor{iliadZinc50}{HTML}{FAFAFA}     % teaching note bg-zinc-50
  \definecolor{iliadZinc200}{HTML}{E4E4E7}    % solution/hint/outcomes border-zinc-200
  \definecolor{iliadZinc300}{HTML}{D4D4D8}    % teaching note border-zinc-300
\fi
\RequirePackage{hyperref}
\hypersetup{colorlinks=true, linkcolor=blue, urlcolor=blue, citecolor=blue}
\RequirePackage[capitalise,noabbrev]{cleveref}

% -------------------------------------------------------- theorem family ---
% One shared counter, numbered within section.
\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{corollary}[theorem]{Corollary}
\newtheorem{fact}[theorem]{Fact}
\theoremstyle{definition}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{example}[theorem]{Example}

% Colours mirror the web components each environment converts to: the
% theorem/lemma/proposition/corollary family is one violet box there (no
% per-kind shade), fact and remark render as the blue note callout, and
% example as the green tip callout.
\ifiliad@boxes
  \tcolorboxenvironment{definition}{colback=iliadIndigo50,  colframe=iliadIndigo300, breakable, top=4pt, bottom=4pt}
  \tcolorboxenvironment{theorem}{colback=iliadViolet50,     colframe=iliadViolet500, breakable, top=4pt, bottom=4pt}
  \tcolorboxenvironment{lemma}{colback=iliadViolet50,       colframe=iliadViolet500, breakable, top=4pt, bottom=4pt}
  \tcolorboxenvironment{proposition}{colback=iliadViolet50, colframe=iliadViolet500, breakable, top=4pt, bottom=4pt}
  \tcolorboxenvironment{corollary}{colback=iliadViolet50,   colframe=iliadViolet500, breakable, top=4pt, bottom=4pt}
  \tcolorboxenvironment{fact}{colback=iliadSky50,           colframe=iliadSky500,    breakable, top=4pt, bottom=4pt}
  \tcolorboxenvironment{example}{colback=iliadEmerald50,    colframe=iliadEmerald500,breakable, top=4pt, bottom=4pt}
\fi

% -------------------------------------------------------------- exercise ---
% Own counter, numbered within section: "Exercise 2.1".
\newcounter{exercise}[section]
\renewcommand{\theexercise}{\thesection.\arabic{exercise}}
\crefname{exercise}{Exercise}{Exercises}
\Crefname{exercise}{Exercise}{Exercises}

\ifiliad@boxes
  \newtcolorbox{exercisebox}{colback=iliadOrange50, colframe=iliadOrange300,
    breakable, top=4pt, bottom=4pt}
\fi

\newcommand{\iliad@exlists}{%
  \setlist[enumerate,1]{label={(\alph*)}, ref={\theexercise(\alph*)}}%
  \setlist[enumerate,2]{label={(\roman*)}, ref={\theenumi(\roman*)}}%
  \crefalias{enumi}{exercise}%
  \crefalias{enumii}{exercise}%
}

% Standard amsthm note semantics: \begin{exercise}[Title].
\newenvironment{exercise}[1][]{%
  \ifiliad@boxes\begin{exercisebox}\else\par\medskip\noindent\fi
  \refstepcounter{exercise}%
  \iliad@exlists
  \textbf{Exercise~\theexercise\ifblank{#1}{}{ (#1)}.}~\ignorespaces
}{%
  \ifiliad@boxes\end{exercisebox}\else\par\medskip\fi
}

% Optional mark, written right after the exercise's \label:
%   \important  ->  (★)   flags the most important exercises
\newcommand{\important}{\textbf{($\bigstar$)}\ \ignorespaces}
% Legacy marks: older sheets still compile, but these are NOT part of the
% contract. \skippable meant "skip on a first pass" (note: the OPPOSITE of
% \important) and prints a small (∗); \difficulty{10} prints [10].
\newcommand{\skippable}{\textbf{($\ast$)}\ \ignorespaces}
\newcommand{\difficulty}[1]{\textbf{[#1]}\ \ignorespaces}

% -------------------------------------------------------------- solution ---
% \begin{solution}[ex:label] — the label of its exercise is REQUIRED, so a
% solution is bound to its exercise no matter where it sits (adjacent or in a
% back-of-sheet section). Hidden entirely (PDF) when \solutionsfalse.
\ifiliad@boxes
  % White body + zinc border, like the web's collapsible <details> box; the
  % title bar keeps the zinc fill, so the label needs black text, not white.
  \newtcolorbox{solutionbox}[1]{colback=white, colframe=iliadZinc200,
    coltitle=black, title={#1}, fonttitle=\bfseries\normalsize, breakable}
\fi

\newenvironment{solution}[1][]{%
  \ifblank{#1}{%
    \PackageError{iliad}{A solution must name its exercise:\MessageBreak
      \string\begin{solution}[ex:label-of-the-exercise]}%
      {Give the label of the exercise this solution answers.}%
  }{}%
  \ifsolutions
    \ifiliad@boxes
      \begin{solutionbox}{Solution to \Cref{#1}}%
    \else
      \par\medskip\noindent\textbf{Solution to \Cref{#1}.}\enspace\ignorespaces
    \fi
    \setlist[enumerate,1]{label={(\alph*)}}%
    \setlist[enumerate,2]{label={(\roman*)}}%
  \else
    \expandafter\comment
  \fi
}{%
  \ifsolutions
    \ifiliad@boxes\end{solutionbox}\else\par\medskip\fi
  \else
    \expandafter\endcomment
  \fi
}

% -------------------------------------------------------- solutions only ---
% \begin{solutionsonly} ... \end{solutionsonly} — content that appears ONLY in
% the solutions build: an answer key, an instructor aside, a spoiler. Plain
% passthrough when solutions are shown; swallowed whole (like a solution) under
% \solutionsfalse / [nosolutions]. Unlike solution it has no box, heading, or
% exercise binding, and is never relocated. The site build removes it from the
% -nosol downloads (stripTexSolutions / stripMdxSolutions), so it is
% spoiler-free there too.
\newenvironment{solutionsonly}{%
  \ifsolutions\else\expandafter\comment\fi
}{%
  \ifsolutions\else\expandafter\endcomment\fi
}

% ------------------------------------------------------- teaching note ---
% \begin{teachingnote}[Session intent] ... \end{teachingnote} — an aside
% addressed to whoever TEACHES the day rather than to the student reading the
% sheet: what a session is for, and how the author ran it last time. The
% optional argument is its label (default "Teaching note"). Kept in both PDF
% variants and on the web, where it renders as a collapsed drop-down
% (<TeachingNote>) so it stays out of the student's reading flow — a PDF has no
% collapsing, so here it is a square-cornered grey box instead. Unnumbered and
% unlabelled, like hint: there is nothing to \cref.
\ifiliad@boxes
  \newtcolorbox{iliadteachingnotebox}[1]{colback=iliadZinc50,
    colframe=iliadZinc300, boxrule=0.4pt, sharp corners,
    title={#1}, fonttitle=\bfseries\normalsize\scshape, coltitle=black!60!white,
    breakable, top=4pt, bottom=4pt}
\fi
\newenvironment{teachingnote}[1][Teaching note]{%
  \ifiliad@boxes
    \begin{iliadteachingnotebox}{#1}%
  \else
    \par\medskip\noindent\textbf{#1.}\enspace\ignorespaces
  \fi
}{%
  \ifiliad@boxes\end{iliadteachingnotebox}\else\par\medskip\fi
}

% -------------------------------------------------------------- pdf only ---
% \begin{pdfonly} ... \end{pdfonly} — content kept in BOTH PDF variants but
% dropped entirely from the web build by the converter (tex2mdx). For content
% that should appear only in the with-solutions PDF (e.g. the heading of a
% back-of-sheet solutions section), nest solutionsonly inside it.
\newenvironment{pdfonly}{}{}

% ------------------------------------------------------------------ hint ---
% One name, two contract forms:
%   \hint{try induction}           inline: prints "[Hint: try induction]"
%   \begin{hint} ... \end{hint}    block: bold "Hint:" lead-in in the PDF;
%                                  a collapsible drop-down on the web.
% The block form is unnumbered, takes no label, and renders where written.
% \hint dispatches on \@currenvir, so the one spot the INLINE form cannot
% sit is the top level of a hint environment (there, just write the words).
\newcommand{\iliad@hint@inline}[1]{[\emph{Hint:} #1]}
\newcommand{\iliad@hint@block}{\par\medskip\noindent\textbf{Hint:}\enspace\ignorespaces}
\newcommand{\hint}{%
  \ifdefstring{\@currenvir}{hint}{\iliad@hint@block}{\iliad@hint@inline}}
% \def, not \newcommand: the kernel's \@ifdefinable refuses every \end...
% name (its "already defined" error is misleading), reserving them for
% environments — which is exactly what this is.
\def\endhint{\par\medskip}

% --------------------------------------------------------------- callout ---
% \begin{callout}[note|tip|warning]  (default: note)
\ifiliad@boxes
  % ([extra tcolorbox options], title, background colour, frame colour) —
  % the web-palette pairs above; the optional first argument lets a caller
  % override keys (learningoutcomes uses it for black-on-zinc title text).
  \newtcolorbox{iliadcalloutbox}[4][]{colback=#3, colframe=#4,
    title={#2}, fonttitle=\bfseries\normalsize, breakable, top=4pt, bottom=4pt, #1}
\fi

\newcommand{\iliad@calloutbegin}[3]{%
  \ifiliad@boxes
    \begin{iliadcalloutbox}{#1}{#2}{#3}%
  \else
    \par\medskip\noindent\textbf{#1.}\enspace\ignorespaces
  \fi
}
\newcommand{\iliad@calloutend}{%
  \ifiliad@boxes\end{iliadcalloutbox}\else\par\medskip\fi
}

% Callouts and remarks may be \label'ed and \cref'ed: each has a discreet
% per-section counter (no number shown in the box; \cref prints e.g.
% "Callout 2.1" / "Remark 2.3" and hyperlinks to the box).
\newcounter{callout}[section]
\renewcommand{\thecallout}{\thesection.\arabic{callout}}
\crefname{callout}{Callout}{Callouts}
\Crefname{callout}{Callout}{Callouts}
\newcounter{remark}[section]
\renewcommand{\theremark}{\thesection.\arabic{remark}}
\crefname{remark}{Remark}{Remarks}
\Crefname{remark}{Remark}{Remarks}

\newenvironment{callout}[1][note]{%
  \refstepcounter{callout}%
  \ifstrequal{#1}{warning}%
    {\def\iliad@co@back{iliadAmber50}\def\iliad@co@frame{iliadAmber500}%
     \def\iliad@co@title{Warning}}%
    {\ifstrequal{#1}{tip}%
      {\def\iliad@co@back{iliadEmerald50}\def\iliad@co@frame{iliadEmerald500}%
       \def\iliad@co@title{Tip}}%
      {\def\iliad@co@back{iliadSky50}\def\iliad@co@frame{iliadSky500}%
       \def\iliad@co@title{Note}}}%
  \iliad@calloutbegin{\iliad@co@title}{\iliad@co@back}{\iliad@co@frame}%
}{%
  \iliad@calloutend
}

% remark — an aside; renders as a note callout on the web. An optional title
% is appended in parentheses: \begin{remark}[Encodings] -> "Remark (Encodings)"
% (matching the tex -> MDX converter, which renders "**Remark (Encodings).**").
\newenvironment{remark}[1][]{%
  \refstepcounter{remark}%
  \iliad@calloutbegin{Remark\ifblank{#1}{}{ (#1)}}{iliadSky50}{iliadSky500}%
}{%
  \iliad@calloutend
}

% ---------------------------------------------------- learning outcomes ---
% A "What you'll learn" box. The body is ordinary LaTeX: write a single
% \begin{itemize} of outcomes, or -- for a longer sheet -- group them under
% \subsection*{...} headings, each followed by its own itemize. Both forms use
% only standard commands (no special markup); see the example worksheet.
\newenvironment{learningoutcomes}{%
  % White + zinc, like the web's "What you'll learn" box; black title text
  % for the same reason as solutionbox.
  \ifiliad@boxes
    \begin{iliadcalloutbox}[coltitle=black]{What you'll learn}{white}{iliadZinc200}%
  \else
    \par\medskip\noindent\textbf{What you'll learn.}\enspace\ignorespaces
  \fi
}{%
  \iliad@calloutend
}

% ------------------------------------------------------------ title block ---
% \author affiliation support (see header). On paper the affiliation sits
% under the name in a smaller face; on the web it becomes "Name (Affiliation)".
\newcommand{\authorname}[1]{#1}
\newcommand{\affiliation}[1]{\normalfont\small #1}

% \begin{summary} ... \end{summary} — legacy; the page summary belongs in the
% %--- iliad --- metadata block (summary: >-). Kept so old sheets compile:
% hoisted into the web frontmatter, italic block in the PDF.
\newenvironment{summary}{\begin{quotation}\noindent\itshape}{\end{quotation}}

% ----------------------------------------------------------------- video ---
% \youtube[Title]{VIDEO_ID} — a YouTube video, by its 11-character ID (the
% v= value of the watch URL), NOT the full URL. On the web the converter
% renders an embedded player; in the PDF this prints a "Video:" line with the
% watch URL — clickable on screen, and readable on a printed sheet, where a
% pretty link label would be lost.
\newcommand{\youtube}[2][]{%
  \par\medskip\noindent\textbf{Video\ifblank{#1}{}{ (#1)}:}\enspace
  \url{https://www.youtube.com/watch?v=#2}%
  \par\medskip
}

% ----------------------------------------------------------- conveniences ---
\providecommand{\note}[1]{[\emph{Note:} #1]}

% Iverson brackets. stmaryrd would supply these, but on Debian it arrives via
% texlive-science, which hard-depends on texlive-lang-greek -- ~79 MB of CI
% download for two glyphs, so they are built from kernel pieces instead.
% \mathopen/\mathclose keep delimiter spacing correct. \providecommand, so a
% sheet that does load stmaryrd keeps stmaryrd's real glyphs.
% The web is unaffected either way: KaTeX has \llbracket natively, and the
% converter never exports these (scripts/tex2mdx/shims.mjs, MACRO_SKIP).
\providecommand{\llbracket}{\mathopen{[\![}}
\providecommand{\rrbracket}{\mathclose{]\!]}}

\endinput
